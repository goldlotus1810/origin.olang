pub fn silk_sv(_p) { kt_silk_init(); let _o = ""; let _h = 0; while _h < 256 { let _e = __kt_silk[_h]; let _i = 0; while _i < len(_e) { let _o = _o + __to_string(_h) + "\t" + __to_string(__array_get(_e, _i)) + "\n"; let _i = _i + 6; }; let _h = _h + 1; }; __file_write(_p, _o); return "ok"; }
pub fn silk_ld(_p) { kt_silk_init(); let _c = __file_read(_p); if len(_c) == 0 { return 0; }; let _n = [0]; let _ls = [0]; let _i = 0; while _i < len(_c) { if __char_code(char_at(_c, _i)) == 10 { let _s = __array_get(_ls, 0); if _i > _s { let _t0 = _find_tab(_c, _s); if _t0 > _s { let _t1 = _find_tab(_c, _t0+1); if _t1 > _t0 { let _hi = __floor(__to_number(substr(_c, _s, _t0))); let _tg = __floor(__to_number(substr(_c, _t0+1, _t1))); if _hi >= 0 { if _hi < 256 { push(__kt_silk[_hi], _tg); push(__kt_silk[_hi], 100); push(__kt_silk[_hi], 100); push(__kt_silk[_hi], 100); push(__kt_silk[_hi], 100); push(__kt_silk[_hi], 100); let _ = __set_at(_n, 0, __array_get(_n, 0)+1); }; }; }; }; }; let _ = __set_at(_ls, 0, _i+1); }; let _i = _i + 1; }; __heap_pin(); return __array_get(_n, 0); }
pub fn stm_sv(_p) { let _o = ""; let _i = 0; while _i < len(__kt_stm_text) { let _t = __array_get(__kt_stm_text, _i); if len(_t) > 0 { let _o = _o + __to_string(__array_get(__kt_stm_mol, _i)) + "\t" + _t + "\n"; }; let _i = _i + 1; }; __file_write(_p, _o); return "ok"; }
pub fn stm_ld(_p) { let _c = __file_read(_p); if len(_c) == 0 { return 0; }; let _n = [0]; let _ls = [0]; let _i = 0; while _i < len(_c) { if __char_code(char_at(_c, _i)) == 10 { let _s = __array_get(_ls, 0); if _i > _s { let _tp = _find_tab(_c, _s); if _tp > _s { let _m = __to_number(substr(_c, _s, _tp)); let _t = substr(_c, _tp+1, _i); if len(_t) > 0 { push(__kt_stm_text, _t); push(__kt_stm_mol, __floor(_m)); push(__kt_stm_access, 1); let _ = __set_at(_n, 0, __array_get(_n, 0)+1); }; }; }; let _ = __set_at(_ls, 0, _i+1); }; let _i = _i + 1; }; __heap_pin(); return __array_get(_n, 0); }
pub fn nox_save() { silk_sv("nox_silk.dat"); stm_sv("nox_stm.dat"); return "saved"; }
